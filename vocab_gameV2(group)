import time
import streamlit as st

st.title("⏱️ เกมทายคำศัพท์ภาษาอังกฤษ หมวดสัตว์ 🦁🐘")

# ----------------------------------------------------
# 📌 [จุดที่ 1] กำหนดค่าเริ่มต้นใน session_state สำหรับคำตอบ 5 ข้อ
# ----------------------------------------------------
if "ans1_val" not in st.session_state:
    st.session_state.ans1_val = ""
if "ans2_val" not in st.session_state:
    st.session_state.ans2_val = ""
if "ans3_val" not in st.session_state:
    st.session_state.ans3_val = ""
if "ans4_val" not in st.session_state:
    st.session_state.ans4_val = ""
if "ans5_val" not in st.session_state:
    st.session_state.ans5_val = ""


# ----------------------------------------------------
# 📌 [จุดที่ 2] ฟังก์ชันรีเซ็ตเกมและล้างค่าช่องพิมพ์คำตอบทั้ง 5 ข้อ
# ----------------------------------------------------
def reset_game():
    st.session_state.ans1_val = ""  # เคลียร์ค่าข้อ 1
    st.session_state.ans2_val = ""  # เคลียร์ค่าข้อ 2
    st.session_state.ans3_val = ""  # เคลียร์ค่าข้อ 3
    st.session_state.ans4_val = ""  # เคลียร์ค่าข้อ 4
    st.session_state.ans5_val = ""  # เคลียร์ค่าข้อ 5
    st.session_state.start = time.time()  # รีเซ็ตตัวจับเวลาใหม่
    st.session_state.is_ended = False  # ปิดการแสดงผล Dialog


# ----------------------------------------------------
# 📌 [จุดที่ 8] ฟังก์ชัน MessageBox (Dialog) สรุปผลคะแนน
# ----------------------------------------------------
@st.dialog("📊 สรุปผลการเล่นเกม")
def show_result_dialog(ans1, ans2, ans3, ans4, ans5):
    st.balloons()
    score = 0

    # 📌 [จุดที่ 3] ทำความสะอาดข้อความ ตัดช่องว่าง และแปลงเป็นอักษรพิมพ์เล็ก
    u_ans1 = ans1.strip().lower()
    u_ans2 = ans2.strip().lower()
    u_ans3 = ans3.strip().lower()
    u_ans4 = ans4.strip().lower()
    u_ans5 = ans5.strip().lower()

    # ตรวจข้อ 1: lion
    if u_ans1 == "lion":
        st.success("✅ ข้อ 1: ถูกต้อง (lion)")
        score += 1
    else:
        st.error(f"❌ ข้อ 1: ยังไม่ถูกต้อง (คุณตอบ '{u_ans1}')")

    # ตรวจข้อ 2: elephant
    if u_ans2 == "elephant":
        st.success("✅ ข้อ 2: ถูกต้อง (elephant)")
        score += 1
    else:
        st.error(f"❌ ข้อ 2: ยังไม่ถูกต้อง (คุณตอบ '{u_ans2}')")

    # 📌 [จุดที่ 4] ตรวจข้อ 3, 4 และ 5
    if u_ans3 == "dog":
        st.success("✅ ข้อ 3: ถูกต้อง (dog)")
        score += 1
    else:
        st.error(f"❌ ข้อ 3: ยังไม่ถูกต้อง (คุณตอบ '{u_ans3}')")

    if u_ans4 == "rabbit":
        st.success("✅ ข้อ 4: ถูกต้อง (rabbit)")
        score += 1
    else:
        st.error(f"❌ ข้อ 4: ยังไม่ถูกต้อง (คุณตอบ '{u_ans4}')")

    if u_ans5 == "zebra":
        st.success("✅ ข้อ 5: ถูกต้อง (zebra)")
        score += 1
    else:
        st.error(f"❌ ข้อ 5: ยังไม่ถูกต้อง (คุณตอบ '{u_ans5}')")

    st.info(f"🏆 ได้คะแนนรวม: {score} / 5 คะแนน")

    # 📌 [จุดที่ 5] เกณฑ์ประเมินผู้เล่นตามระดับคะแนน 0 - 5 (If-Else)
    if score == 5:
        st.success("🎉 5 คะแนน = เทพสุดๆไปเลย!")
    elif score == 4:
        st.success("🌟 4 คะแนน = สุดยอด!")
    elif score == 3:
        st.info("👍 3 คะแนน = เก่ง!")
    elif score == 2:
        st.warning("👌 2 คะแนน = ใช้ได้!")
    elif score == 1:
        st.warning("💪 1 คะแนน = พยายามอีกนิด!")
    else:
        st.error("💀 0 คะแนน = ลองใหม่น่ะ!")


# ----------------------------------------------------
# 1. ปุ่มเริ่มเล่นเกม
# ----------------------------------------------------
st.button("🎮 เริ่มเล่นเกม / รีเซ็ต", on_click=reset_game)

# 2. แถบแสดงเวลานับถอยหลัง (นับถอยหลัง 40 วินาที)
if "start" in st.session_state and not st.session_state.get("is_ended", False):
    time_left = int(40 - (time.time() - st.session_state.start))

    if time_left > 0:
        st.error(f"⏳ เหลือเวลา: {time_left} วินาที")
    else:
        st.session_state.is_ended = True
        st.rerun()

st.divider()

# ----------------------------------------------------
# 📌 [จุดที่ 6] ช่องรับคำตอบ 5 ข้อ (หมวดสัตว์)
# ----------------------------------------------------
ans1 = st.text_input(
    "ข้อ 1: King of the jungle `l _ o n` 🦁",
    value=st.session_state.ans1_val,
    key="input_1",
)
ans2 = st.text_input(
    "ข้อ 2: Huge animal with a long trunk `e _ e p h _ n t` 🐘",
    value=st.session_state.ans2_val,
    key="input_2",
)
ans3 = st.text_input(
    "ข้อ 3: Man's best friend that barks `d _ g` 🐶",
    value=st.session_state.ans3_val,
    key="input_3",
)
ans4 = st.text_input(
    "ข้อ 4: Cute animal that eats carrots `r _ b b _ t` 🐰",
    value=st.session_state.ans4_val,
    key="input_4",
)
ans5 = st.text_input(
    "ข้อ 5: Black and white striped animal `z _ b r _` 🦓",
    value=st.session_state.ans5_val,
    key="input_5",
)

# 📌 [จุดที่ 7] อัปเดตค่าล่าสุดเข้า session_state
st.session_state.ans1_val = ans1
st.session_state.ans2_val = ans2
st.session_state.ans3_val = ans3
st.session_state.ans4_val = ans4
st.session_state.ans5_val = ans5


# ----------------------------------------------------
# 4. ปุ่มส่งคำตอบ และการเรียกแสดง Dialog ผลลัพธ์
# ----------------------------------------------------
if "start" in st.session_state and not st.session_state.get("is_ended", False):
    if st.button("📥 ส่งคำตอบ"):
        st.session_state.is_ended = True
        st.rerun()

# 📌 [จุดที่ 8] ส่งค่า ans1 ถึง ans5 เข้า Dialog
if st.session_state.get("is_ended", False):
    show_result_dialog(ans1, ans2, ans3, ans4, ans5)

st.divider()
st.write("ผู้จัดทำ: (ใส่ชื่อ-นามสกุล และชั้นมัธยมศึกษาของสมาชิกในกลุ่ม)")
